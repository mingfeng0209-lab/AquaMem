<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>底片接力・隨機任務機</title>
  <style>
    :root {
      --bg: #121214;
      --card-bg: #1e1e24;
      --accent: #f59e0b;
      --accent-hover: #d97706;
      --text: #f3f4f6;
      --text-muted: #9ca3af;
      --border: #2e2e38;
      --danger: #ef4444;
      --success: #10b981;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      min-height: 100vh;
      padding: 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .container {
      width: 100%;
      max-width: 480px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    /* 頂部進度卡 */
    .header-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .counter-badge {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--accent);
      background: rgba(245, 158, 11, 0.15);
      padding: 6px 12px;
      border-radius: 999px;
    }

    .pool-stat {
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    /* 主抽籤卡片 */
    .draw-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 24px 20px;
      text-align: center;
      position: relative;
      box-shadow: 0 10px 25px rgba(0,0,0,0.3);
    }

    .topic-display {
      min-height: 110px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      margin-bottom: 20px;
    }

    .topic-title {
      font-size: 1.9rem;
      font-weight: 800;
      letter-spacing: 1px;
      color: #ffffff;
      margin-bottom: 8px;
    }

    .topic-desc {
      font-size: 0.95rem;
      color: var(--text-muted);
      line-height: 1.4;
    }

    .btn-draw {
      width: 100%;
      background: var(--accent);
      color: #000;
      font-size: 1.15rem;
      font-weight: 700;
      border: none;
      border-radius: 14px;
      padding: 16px;
      cursor: pointer;
      transition: all 0.15s ease;
      box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
    }

    .btn-draw:active {
      transform: scale(0.98);
      background: var(--accent-hover);
    }

    /* 拍攝人選擇區 */
    .save-section {
      margin-top: 20px;
      padding-top: 18px;
      border-top: 1px dashed var(--border);
      display: none;
      flex-direction: column;
      gap: 12px;
    }

    .member-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: center;
    }

    .member-chip {
      background: #2a2a35;
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 8px 14px;
      font-size: 0.9rem;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .member-chip.active {
      background: var(--accent);
      color: #000;
      font-weight: 700;
      border-color: var(--accent);
    }

    .btn-save {
      width: 100%;
      background: var(--success);
      color: #fff;
      font-size: 1rem;
      font-weight: 600;
      border: none;
      border-radius: 12px;
      padding: 14px;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .btn-save:active {
      opacity: 0.9;
    }

    /* 清單區域 */
    .list-section {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 18px;
    }

    .list-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
    }

    .list-title {
      font-size: 1.05rem;
      font-weight: 700;
    }

    .list-actions {
      display: flex;
      gap: 8px;
    }

    .btn-action {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text-muted);
      border-radius: 8px;
      padding: 5px 10px;
      font-size: 0.8rem;
      cursor: pointer;
    }

    .btn-action:hover {
      color: var(--text);
      border-color: var(--text-muted);
    }

    .record-list {
      list-style: none;
      display: flex;
      flex-direction: column-reverse;
      gap: 10px;
      max-height: 380px;
      overflow-y: auto;
    }

    .record-item {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 10px;
      padding: 10px 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .record-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .record-num {
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--accent);
      min-width: 28px;
    }

    .record-theme {
      font-weight: 600;
      font-size: 0.95rem;
    }

    .record-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .record-user {
      font-size: 0.85rem;
      color: #93c5fd;
      background: rgba(147, 197, 253, 0.1);
      padding: 3px 8px;
      border-radius: 6px;
    }

    .record-time {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .empty-hint {
      text-align: center;
      color: var(--text-muted);
      font-size: 0.9rem;
      padding: 24px 0;
    }

    /* 成員編輯 Modal */
    .modal {
      display: none;
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.7);
      backdrop-filter: blur(4px);
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 100;
    }

    .modal-content {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 20px;
      width: 100%;
      max-width: 380px;
    }

    .modal-input {
      width: 100%;
      background: var(--bg);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 10px;
      border-radius: 8px;
      font-size: 0.95rem;
      margin: 12px 0;
    }
  </style>
</head>
<body>

  <div class="container">
    <!-- 進度與狀態 -->
    <div class="header-card">
      <div>
        <div class="counter-badge" id="shotCountBadge">已拍攝：0 / 25 張</div>
      </div>
      <div class="pool-stat" id="poolStat">剩餘主題：100 / 100</div>
    </div>

    <!-- 隨機抽選區 -->
    <div class="draw-card">
      <div class="topic-display">
        <div class="topic-title" id="topicTitle">準備好了嗎？</div>
        <div class="topic-desc" id="topicDesc">點擊下方按鈕抽選一張專屬主題</div>
      </div>

      <button class="btn-draw" id="drawBtn" onclick="drawTopic()">🎲 抽選主題</button>

      <!-- 拍攝者確認與儲存區 -->
      <div class="save-section" id="saveSection">
        <div style="font-size: 0.85rem; color: var(--text-muted); text-align: left;">
          誰按下了快門？（點選拍攝者）：
        </div>
        <div class="member-chips" id="memberChips">
          <!-- 成員標籤透過 JS 動態生成 -->
        </div>
        <button class="btn-save" id="saveBtn" onclick="saveCurrentShot()">📸 確認拍下並交棒</button>
      </div>
    </div>

    <!-- 歷史拍攝清單 -->
    <div class="list-section">
      <div class="list-header">
        <div class="list-title">📋 拍攝完成清單</div>
        <div class="list-actions">
          <button class="btn-action" onclick="copyListText()">複製文字</button>
          <button class="btn-action" onclick="openMemberModal()">編輯名單</button>
          <button class="btn-action" style="color: var(--danger);" onclick="resetAllData()">重設</button>
        </div>
      </div>
      <ul class="record-list" id="recordList">
        <!-- 動態渲染清單 -->
      </ul>
      <div class="empty-hint" id="emptyHint">尚無拍攝紀錄，快抽籤開始第一棒吧！</div>
    </div>
  </div>

  <!-- 成員自訂 Modal -->
  <div class="modal" id="memberModal">
    <div class="modal-content">
      <h3 style="margin-bottom: 8px;">編輯 5 位成員名稱</h3>
      <p style="font-size: 0.8rem; color: var(--text-muted);">請用逗號（,）分開每位成員名字：</p>
      <input type="text" class="modal-input" id="memberInput" value="同事A,同事B,同事C,同事D,同事E">
      <div style="display: flex; gap: 8px; justify-content: flex-end;">
        <button class="btn-action" onclick="closeMemberModal()">取消</button>
        <button class="btn-action" style="background: var(--accent); color: #000; border: none; font-weight: bold;" onclick="saveMembers()">儲存</button>
      </div>
    </div>
  </div>

