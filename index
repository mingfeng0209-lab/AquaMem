      { id: 83, title: "【緊繃】", desc: "握緊的拳頭、拉直的繩索或僵硬的身體線條" },
      { id: 84, title: "【背對背】", desc: "兩個人或兩件事物朝向完全相反的方向" },
      { id: 85, title: "【波紋】", desc: "水面漣漪、布料波浪、或是皺褶形成的紋路" },
      { id: 86, title: "【粗糙】", desc: "柏油路面、樹皮、石頭或未經修飾的粗粒質感" },
      { id: 87, title: "【鏡頭外】", desc: "畫面裡有一隻手或腳伸進來，提示鏡頭外有人" },
      { id: 88, title: "【平行】", desc: "兩條永不相交的軌跡、並排的手指或並列的物件" },
      { id: 89, title: "【沉醉】", desc: "閉上眼享受、深呼吸、喝到第一口飲料的陶醉感" },
      { id: 90, title: "【空隙】", desc: "兩個人肩膀之間、兩件物體縫隙中看到的景物" },
      { id: 91, title: "【下沉】", desc: "視線往低處落、東西掉落、或是坐進深處的陷落感" },
      { id: 92, title: "【上升】", desc: "蒸氣上升、舉起的手、或是往高處跳躍的動態" },
      { id: 93, title: "【模糊】", desc: "故意對焦在錯誤位置、前景模糊或移動拖影" },
      { id: 94, title: "【光斑】", desc: "樹葉縫隙灑落的圓形光點或鏡頭炫光" },
      { id: 95, title: "【錯位】", desc: "視覺上看起來像戴了怪帽子或長出奇怪肢體的錯覺" },
      { id: 96, title: "【舊】", desc: "褪色的包裝、磨損的皮件、老舊痕跡或復古質感" },
      { id: 97, title: "【鮮豔】", desc: "畫面色彩飽和度極高、視覺衝擊強烈的一刻" },
      { id: 98, title: "【節奏】", desc: "連續排列的燈柱、間隔均勻的影子或規律的起伏" },
      { id: 99, title: "【釋放】", desc: "大笑、長吁一口氣、放下背包或伸直雙腿的解脫感" },
      { id: 100, title: "【未完】", desc: "話講到一半、事情做到一半、尚未結束的進行式" }
    ];

    // 狀態變數
    let members = JSON.parse(localStorage.getItem('relay_members')) || ["同事A", "同事B", "同事C", "同事D", "同事E"];
    let savedRecords = JSON.parse(localStorage.getItem('relay_records')) || [];
    let currentDrawn = null;
    let selectedMember = null;

    // 初始化
    function init() {
      renderMembers();
      renderRecords();
      updateStats();
    }

    // 取得當前可用主題池（排除已儲存的主題）
    function getAvailablePool() {
      const savedIds = new Set(savedRecords.map(r => r.themeId));
      return FULL_THEME_POOL.filter(t => !savedIds.has(t.id));
    }

    // 更新統計數據
    function updateStats() {
      const available = getAvailablePool();
      document.getElementById('shotCountBadge').innerText = `已拍攝：${savedRecords.length} / 25 張`;
      document.getElementById('poolStat').innerText = `剩餘主題：${available.length} / ${FULL_THEME_POOL.length}`;
    }

    // 抽籤動作
    function drawTopic() {
      const pool = getAvailablePool();
      if (pool.length === 0) {
        alert("100 個主題已經全數抽完囉！");
        return;
      }

      const drawBtn = document.getElementById('drawBtn');
      drawBtn.disabled = true;

      // 跑動動畫效果
      let counter = 0;
      const interval = setInterval(() => {
        const rand = pool[Math.floor(Math.random() * pool.length)];
        document.getElementById('topicTitle').innerText = rand.title;
        document.getElementById('topicDesc').innerText = rand.desc;
        counter++;
        if (counter > 10) {
          clearInterval(interval);
          const finalPick = pool[Math.floor(Math.random() * pool.length)];
          currentDrawn = finalPick;
          document.getElementById('topicTitle').innerText = finalPick.title;
          document.getElementById('topicDesc').innerText = finalPick.desc;
          
          // 自動推測下一棒是誰
          autoSelectNextMember();
          
          document.getElementById('saveSection').style.display = 'flex';
          drawBtn.disabled = false;
        }
      }, 50);
    }

    // 自動推薦下一位接棒者
    function autoSelectNextMember() {
      if (members.length === 0) return;
      const nextIdx = savedRecords.length % members.length;
      selectMember(members[nextIdx]);
    }

    // 選擇拍攝者
    function selectMember(name) {
      selectedMember = name;
      document.querySelectorAll('.member-chip').forEach(el => {
        el.classList.toggle('active', el.dataset.name === name);
      });
    }

    // 儲存紀錄
    function saveCurrentShot() {
      if (!currentDrawn) return;
      if (!selectedMember) {
        alert("請先點選拍攝者是誰！");
        return;
      }

      const now = new Date();
      const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;

      const newRecord = {
        shotNo: savedRecords.length + 1,
        themeId: currentDrawn.id,
        themeTitle: currentDrawn.title,
        photographer: selectedMember,
        time: timeStr
      };

      savedRecords.push(newRecord);
      localStorage.setItem('relay_records', JSON.stringify(savedRecords));

      // 重置當前卡片
      currentDrawn = null;
      document.getElementById('saveSection').style.display = 'none';
      document.getElementById('topicTitle').innerText = "✅ 快門已按下！";
      document.getElementById('topicDesc').innerText = `第 ${newRecord.shotNo} 張完成，請過片滾輪轉到底交給下一位`;

      renderRecords();
      updateStats();
    }

    // 渲染清單
    function renderRecords() {
      const listEl = document.getElementById('recordList');
      const emptyEl = document.getElementById('emptyHint');
      listEl.innerHTML = '';

      if (savedRecords.length === 0) {
        emptyEl.style.display = 'block';
        return;
      }
      emptyEl.style.display = 'none';

      savedRecords.forEach(r => {
        const li = document.createElement('li');
        li.className = 'record-item';
        li.innerHTML = `
          <div class="record-left">
            <span class="record-num">#${String(r.shotNo).padStart(2, '0')}</span>
            <span class="record-theme">${r.themeTitle}</span>
          </div>
          <div class="record-right">
            <span class="record-user">${r.photographer}</span>
            <span class="record-time">${r.time}</span>
          </div>
        `;
        listEl.appendChild(li);
      });
    }

    // 渲染成員標籤
    function renderMembers() {
      const container = document.getElementById('memberChips');
      container.innerHTML = '';
      members.forEach(m => {
        const chip = document.createElement('div');
        chip.className = 'member-chip';
        chip.innerText = m;
        chip.dataset.name = m;
        chip.onclick = () => selectMember(m);
        container.appendChild(chip);
      });
    }

    // 複製文字清單
    function copyListText() {
      if (savedRecords.length === 0) {
        alert("清單是空的，還沒有任何紀錄喔！");
        return;
      }
      let text = "📷【即可拍 12 小時接力清單】\n";
      savedRecords.forEach(r => {
        text += `#${r.shotNo} ${r.themeTitle} - ${r.photographer} (${r.time})\n`;
      });
      navigator.clipboard.writeText(text).then(() => {
        alert("已成功複製清單文字，可直接貼到 LINE！");
      }).catch(() => {
        alert("複製失敗，請手動選取文字");
      });
    }

    // 成員編輯 Modal 邏輯
    function openMemberModal() {
      document.getElementById('memberInput').value = members.join(',');
      document.getElementById('memberModal').style.display = 'flex';
    }

    function closeMemberModal() {
      document.getElementById('memberModal').style.display = 'none';
    }

    function saveMembers() {
      const val = document.getElementById('memberInput').value;
      const parsed = val.split(',').map(s => s.trim()).filter(s => s.length > 0);
      if (parsed.length === 0) {
        alert("至少需要填寫一位成員名稱");
        return;
      }
      members = parsed;
      localStorage.setItem('relay_members', JSON.stringify(members));
      renderMembers();
      closeMemberModal();
    }

    // 重設所有紀錄
    function resetAllData() {
      if (confirm("確定要清空所有已拍紀錄並重置 100 個主題庫嗎？（此動作無法還原）")) {
        savedRecords = [];
        localStorage.removeItem('relay_records');
        currentDrawn = null;
        document.getElementById('saveSection').style.display = 'none';
        document.getElementById('topicTitle').innerText = "準備好了嗎？";
        document.getElementById('topicDesc').innerText = "點擊下方按鈕抽選一張專屬主題";
        renderRecords();
        updateStats();
      }
    }

    // 啟動 App
    init();
  </script>
</body>
</html>
